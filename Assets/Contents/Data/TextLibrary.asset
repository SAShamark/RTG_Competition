%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40623360538d3b4419b54433e8bf3736, type: 3}
  m_Name: TextLibrary
  m_EditorClassIdentifier: Assembly-CSharp::Game.Texts.TextLibrary
  _texts:
  - _id: 1
    _text: "\u041F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438 \u0432 \u043F\u0456\u0434'\u0457\u0437\u0434"
  - _id: 2
    _text: "\u0412\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438"
  - _id: 3
    _text: "\u0437\u0430\u0447\u0438\u043D\u0435\u043D\u043E"
  - _id: 4
    _text: "\u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430 \u043F\u043E\u0440\u043E\u0436\u043D\u044F"
  - _id: 5
    _text: "\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0432\u0456\u0434\u043C\u0438\u0447\u043A\u043E\u044E"
  - _id: 6
    _text: "\u041A\u043E\u0442\u0456\u0432 \u0443\u0440\u044F\u0442\u043E\u0432\u0430\u043D\u043E: 6  (\u043D\u0435 \u0442\u043E\u0431\u043E\u044E)"
  - _id: 7
    _text: "\u0417\u0430\u043C\u043E\u043A \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u043E"
  - _id: 8
    _text: "\u0417\u043D\u0430\u0439\u0434\u0438 \u0441\u043E\u043A\u0438\u0440\u0443 \u0431\u0456\u043B\u044F \u043C\u0430\u0448\u0438\u043D\u0438"
  - _id: 9
    _text: "\u0417\u0431\u0438\u0439 \u0437\u0430\u043C\u043E\u043A \u043D\u0430 \u0434\u0432\u0435\u0440\u044F\u0445 \u043F\u0456\u0434'\u0457\u0437\u0434\u0443"
  - _id: 10
    _text: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0439 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438 \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432"
  - _id: 11
    _text: "\u041C\u0430\u0445\u043C\u0443\u0434\u0435, \u0431\u0443\u0434\u0438\u043D\u043E\u043A \u211612! \u0414\u0432\u0435\u0440\u0456 \u043F\u0456\u0434'\u0457\u0437\u0434\u0443 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u044E."
  - _id: 12
    _text: "\u041F\u0456\u0434'\u0457\u0437\u0434"
  - _id: 13
    _text: "\u041C\u0430\u0448\u0438\u043D\u0430"
  - _id: 14
    _text: "\u0421\u043E\u043A\u0438\u0440\u0430 \u0443 \u0432\u0456\u0434\u0441\u0456\u043A\u0443 \u0437\u0431\u043E\u043A\u0443 \u043C\u0430\u0448\u0438\u043D\u0438. \u041F\u0456\u0434 \u0440\u0435\u0447\u0430\u043C\u0438 \u043F\u043E\u0448\u0443\u043A\u0430\u0439!"
  - _id: 15
    _text: "\u041F\u0456\u0434\u0456\u0431\u0440\u0430\u043D\u043E: \u0441\u043E\u043A\u0438\u0440\u0443"
  - _id: 16
    _text: "\u041F\u0456\u0434\u0445\u043E\u0434\u044C \u0434\u043E \u0434\u0432\u0435\u0440\u0435\u0439 \u0456 \u0437\u0431\u0438\u0439 \u0437\u0430\u043C\u043E\u043A \u0441\u043E\u043A\u0438\u0440\u043E\u044E!"
  - _id: 17
    _text: "\u0417\u043B\u0430\u043C\u0430\u043D\u043E: \u0437\u0430\u043C\u043E\u043A"
  - _id: 18
    _text: "\u0412\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u0449\u0435 \u043B\u044E\u0434\u0438! \u0428\u0443\u043A\u0430\u0439 \u043F\u043E \u043F\u043E\u0432\u0435\u0440\u0445\u0430\u0445, \u0441\u043B\u0443\u0445\u0430\u0439 \u043A\u0440\u0438\u043A\u0438."
  - _id: 19
    _text: "\u0412\u043E\u0433\u043D\u0435\u0433\u0430\u0441\u043D\u0438\u043A \u0443 \u0447\u0435\u0440\u0432\u043E\u043D\u043E\u043C\u0443 \u0449\u0438\u0442\u043A\u0443 \u043D\u0430 \u0441\u0442\u0456\u043D\u0456. \u0412\u0456\u0434\u0447\u0438\u043D\u044F\u0439 \u0456 \u0431\u0435\u0440\u0438!"
  - _id: 20
    _text: "\u0417\u0430\u0442\u0438\u0441\u043D\u0438 \u041B\u041A\u041C \u0456 \u0433\u0430\u0441\u0438 \u0432\u043E\u0433\u043E\u043D\u044C \u0431\u0456\u043B\u044F \u0441\u0445\u043E\u0434\u0456\u0432. \u0426\u0456\u043B\u044C\u0441\u044F \u0432 \u043E\u0441\u043D\u043E\u0432\u0443 \u043F\u043E\u043B\u0443\u043C'\u044F!"
  - _id: 21
    _text: "\u0417\u0430\u0433\u0430\u0441\u0438\u0442\u0438 \u0432\u043E\u0433\u043E\u043D\u044C \u0431\u0456\u043B\u044F \u0441\u0445\u043E\u0434\u0456\u0432"
  - _id: 22
    _text: "\u0412\u0437\u044F\u0442\u0438 \u0432\u043E\u0433\u043D\u0435\u0433\u0430\u0441\u043D\u0438\u043A \u0437\u0456 \u0449\u0438\u0442\u043A\u0430"
  - _id: 23
    _text: "\u041F\u0456\u0434\u043D\u044F\u0442\u0438\u0441\u044F \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0439 \u043F\u043E\u0432\u0435\u0440\u0445"
  - _id: 24
    _text: "\u041C\u0430\u0445\u043C\u0443\u0434\u0435, \u043A\u0430\u0448\u0435\u043B\u044C \u0447\u0443\u0442\u0438 \u0437 \u043B\u0456\u0432\u043E\u0457 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0438! \u0414\u0432\u0435\u0440\u0456 \u043B\u0456\u0432\u043E\u0440\u0443\u0447 \u0432\u0456\u0434 \u0441\u0445\u043E\u0434\u0456\u0432."
  - _id: 25
    _text: "\u0411\u0430\u0447\u0438\u0448 \u0457\u0457? \u0413\u0430\u0441\u0438 \u0432\u043E\u0433\u043E\u043D\u044C \u0456 \u0432\u0438\u0432\u043E\u0434\u044C!"
  - _id: 26
    _text: "\u0421\u0435\u0439\u0444 \u0437\u043D\u0430\u0439\u0448\u043E\u0432? \u0412\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0439, \u0431\u0430\u0431\u0443\u0441\u044F \u0431\u0435\u0437 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0456\u0432 \u043D\u0435 \u043F\u0456\u0434\u0435!"
  - _id: 27
    _text: "\u0411\u0430\u0431\u0443\u0441\u044F \u043A\u0430\u0436\u0435 \u2014 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438 \u0437\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u044E. \u041F\u043E\u0448\u0443\u043A\u0430\u0439 \u0441\u0435\u0439\u0444!"
  - _id: 28
    _text: "\u0411\u0430\u0442\u0443\u0442 \u043F\u0456\u0434 \u043B\u0456\u0432\u0438\u043C \u0432\u0456\u043A\u043D\u043E\u043C! \u041D\u0435\u0441\u0438 \u0431\u0430\u0431\u0443\u0441\u044E \u0434\u043E \u0432\u0456\u043A\u043D\u0430 \u0439 \u043A\u0438\u0434\u0430\u0439 \u043C\u0435\u043D\u0456!"
  - _id: 29
    _text: "\u0422\u0440\u0435\u0442\u0456\u0439 \u043F\u043E\u0432\u0435\u0440\u0445, \u041C\u0430\u0445\u043C\u0443\u0434\u0435! \u0422\u0430\u043C \u0445\u0442\u043E\u0441\u044C \u043A\u0440\u0438\u0447\u0438\u0442\u044C!"
  - _id: 30
    _text: "\u0411\u0430\u0431\u0443\u0441\u044F"
  - _id: 31
    _text: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043F\u043E\u0432\u0435\u0440\u0445\u0443"
  - _id: 32
    _text: "\u0417\u0430\u0433\u0430\u0441\u0438\u0442\u0438 \u0432\u043E\u0433\u043E\u043D\u044C \u0456 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u0431\u0430\u0431\u0443\u0441\u0456"
  - _id: 33
    _text: "\u0412\u0438\u0432\u0435\u0441\u0442\u0438 \u0431\u0430\u0431\u0443\u0441\u044E"
  - _id: 34
    _text: "\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0441\u0435\u0439\u0444"
  - _id: 35
    _text: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438 \u0437\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u044E"
  - _id: 36
    _text: "\u0421\u0435\u0439\u0444 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u043E"
  - _id: 37
    _text: "\u0417\u0430\u0431\u0440\u0430\u0442\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438"
  - _id: 38
    _text: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E"
  - _id: 39
    _text: "\u0415\u0432\u0430\u043A\u0443\u044E\u0432\u0430\u0442\u0438 \u0431\u0430\u0431\u0443\u0441\u044E \u0447\u0435\u0440\u0435\u0437 \u0432\u0456\u043A\u043D\u043E"
  - _id: 40
    _text: "\u041F\u0456\u0434\u043D\u044F\u0442\u0438\u0441\u044F \u043D\u0430 \u0442\u0440\u0435\u0442\u0456\u0439 \u043F\u043E\u0432\u0435\u0440\u0445"
  - _id: 41
    _text: "3-\u0439 \u043F\u043E\u0432\u0435\u0440\u0445"
  - _id: 42
    _text: "\u041A\u0440\u0438\u0447\u0430\u0442\u044C \u0437 \u0442\u0440\u0435\u0442\u044C\u043E\u0433\u043E \u043F\u043E\u0432\u0435\u0440\u0445\u0443! \u041F\u0440\u043E\u0447\u0438\u043D\u0435\u043D\u0456 \u0434\u0432\u0435\u0440\u0456 \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447 \u0432\u0456\u0434 \u0441\u0445\u043E\u0434\u0456\u0432."
  - _id: 43
    _text: "\u0412\u0435\u043D\u0442\u0438\u043B\u0456 \u0432 \u043A\u043E\u043C\u043E\u0440\u0456. \u0417\u0430\u043C\u043E\u043A \u2014 \u0432\u0456\u0434\u043C\u0438\u0447\u043A\u043E\u044E, \u0430 \u043C\u0430\u0445\u043E\u0432\u0438\u043A\u0438 \u043F\u043E\u0448\u0443\u043A\u0430\u0439 \u0442\u0430\u043C \u0436\u0435 \u2014 \u0443 \u044F\u0449\u0438\u043A\u0443 \u0439 \u043F\u0456\u0434 \u043C\u043E\u0442\u043B\u043E\u0445\u043E\u043C!"
  - _id: 44
    _text: "\u041C\u0430\u0445\u043E\u0432\u0438\u043A\u0438 \u0454 \u2014 \u0441\u0442\u0430\u0432 \u043D\u0430 \u0432\u0435\u043D\u0442\u0438\u043B\u0456. \u0406 \u0434\u0438\u0432\u0438\u0441\u044C \u043D\u0430 \u0441\u0445\u0435\u043C\u0443: \u0441\u043F\u0435\u0440\u0448\u0443 \u0432\u0438\u0442\u044F\u0436\u043A\u0430, \u043F\u043E\u0442\u0456\u043C \u0433\u0430\u0437!"
  - _id: 45
    _text: "\u0413\u0430\u0437 \u043F\u0435\u0440\u0435\u043A\u0440\u0438\u0442\u043E \u2014 \u0434\u043E\u0433\u0430\u0448\u0443\u0439 \u043A\u0443\u0445\u043D\u044E!"
  - _id: 46
    _text: "\u0411\u0430\u0442\u0443\u0442 \u043F\u0456\u0434 \u0432\u0456\u043A\u043D\u043E\u043C \u043A\u0443\u0445\u043D\u0456! \u041D\u0435\u0441\u0438 \u0439\u043E\u0433\u043E \u0434\u043E \u0432\u0456\u043A\u043D\u0430 \u0439 \u043A\u0438\u0434\u0430\u0439!"
  - _id: 47
    _text: "\u0427\u0435\u0442\u0432\u0435\u0440\u0442\u0438\u0439 \u043F\u043E\u0432\u0435\u0440\u0445, \u041C\u0430\u0445\u043C\u0443\u0434\u0435!"
  - _id: 48
    _text: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u044F"
  - _id: 49
    _text: "\u041A\u0440\u0438\u043A \u043F\u0440\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443"
  - _id: 50
    _text: "\u041F\u0428\u0428\u0428\u0428\u0428!"
  - _id: 51
    _text: "\u0422\u0456\u043A\u0430\u0442\u0438!"
  - _id: 52
    _text: "\u0414\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u044F"
  - _id: 53
    _text: "\u041F\u0435\u0440\u0435\u043A\u0440\u0438\u0442\u0438 \u0433\u0430\u0437 \u0443 \u043A\u043E\u043C\u043E\u0440\u0456"
  - _id: 54
    _text: "\u041A\u043E\u043C\u043E\u0440\u0430"
  - _id: 55
    _text: "\u041C\u0430\u0445\u043E\u0432\u0438\u043A \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u043E"
  - _id: 56
    _text: "\u0415\u0432\u0430\u043A\u0443\u044E\u0432\u0430\u0442\u0438 \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u044F"
  - _id: 57
    _text: "\u0417\u0430\u0433\u0430\u0441\u0438\u0442\u0438 \u0432\u043E\u0433\u043E\u043D\u044C \u043D\u0430 \u043A\u0443\u0445\u043D\u0456"
  - _id: 58
    _text: "\u041A\u0443\u0445\u043D\u044F"
  - _id: 59
    _text: "\u0412\u0438\u0439\u0442\u0438 \u0437 \u0431\u0443\u0434\u0438\u043D\u043A\u0443"
  - _id: 60
    _text: "\u041C\u0430\u0445\u043E\u0432\u0438\u043A \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E"
  - _id: 61
    _text: "\u041D\u0435\u043C\u0430\u0454 \u043C\u0430\u0445\u043E\u0432\u0438\u043A\u0430"
  - _id: 62
    _text: "\u0428\u0448\u0448! \u041D\u0435 \u0442\u0443\u0434\u0438 \u2014 \u0432\u0435\u043D\u0442\u0438\u043B\u044C \u0432\u0456\u0434\u0441\u043A\u043E\u0447\u0438\u0432 \u043D\u0430\u0437\u0430\u0434"
  - _id: 63
    _text: "\u041A\u043B\u0430\u0446!"
  - _id: 64
    _text: "\u0429\u0435 \u043E\u0431\u0435\u0440\u0442..."
  - _id: 65
    _text: "\u0413\u0430\u0437 \u043F\u0435\u0440\u0435\u043A\u0440\u0438\u0442\u043E"
  - _id: 66
    _text: "\u0417\u043D\u0430\u0439\u0434\u0435\u043D\u043E: \u043C\u0430\u0445\u043E\u0432\u0438\u043A \u0432\u0435\u043D\u0442\u0438\u043B\u044F"
  - _id: 67
    _text: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043C\u0430\u0445\u043E\u0432\u0438\u043A\u0438: {0}/{1}"
  - _id: 68
    _text: "\u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043C\u0430\u0445\u043E\u0432\u0438\u043A\u0438 \u043D\u0430 \u0432\u0435\u043D\u0442\u0438\u043B\u0456"
  - _id: 69
    _text: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438 \u0432\u0435\u043D\u0442\u0438\u043B\u0456 \u0437\u0430 \u0441\u0445\u0435\u043C\u043E\u044E"
  - _id: 70
    _text: "\u041D\u0435\u0441\u0438 \u0434\u043E \u0432\u0456\u043A\u043D\u0430 \u0437 \u0431\u0430\u0442\u0443\u0442\u043E\u043C \xB7 [G] \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438"
  - _id: 71
    _text: "\u0412\u043E\u0433\u043D\u0435\u0433\u0430\u0441\u043D\u0438\u043A \xB7 \u0437\u0430\u0442\u0438\u0441\u043D\u0438 \u041B\u041A\u041C, \u0449\u043E\u0431 \u0433\u0430\u0441\u0438\u0442\u0438"
  - _id: 72
    _text: "\u041D\u0435\u043C\u0430\u0454 \u043C\u0456\u0441\u0446\u044F: \u0432\u0456\u043B\u044C\u043D\u0438\u0445 \u043A\u043E\u043C\u0456\u0440\u043E\u043A \u043D\u0435\u043C\u0430\u0454"
  - _id: 73
    _text: "\u0412\u0440\u044F\u0442\u043E\u0432\u0430\u043D\u043E: {0} / {1}"
  - _id: 74
    _text: "+{0} \u20B4"
  - _id: 75
    _text: "[E] \u0412\u0437\u044F\u0442\u0438 {0}"
  - _id: 76
