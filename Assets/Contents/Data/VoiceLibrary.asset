%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6f418fcdaea63546b46d87a0d211068, type: 3}
  m_Name: VoiceLibrary
  m_EditorClassIdentifier: Assembly-CSharp::Game.Voice.VoiceLibrary
  _characters:
  - _character: 0
    _displayName: "\u041D\u0430\u043F\u0430\u0440\u043D\u0438\u043A"
    _color: {r: 1, g: 0.76, b: 0.29, a: 1}
    _lines:
    - _id: P01
      _text: "\u0422\u0438 \u0448\u043E, \u043F\u043E\u0436\u0435\u0436\u0443 \u043E\u0431\u0433\u0430\u043D\u044F\u0454\u0448?! \u0413\u0430\u043B\u044C\u043C\u0443\u0439, \u041C\u0430\u0445\u043C\u0443\u0434!"
      _clip: {fileID: 8300000, guid: 5b1883b007c58104ab4df0a287104ca4, type: 3}
      _hold: 3
    - _id: P02
      _text: "\u041C\u0430\u0445\u043C\u0443\u0434\u0435, \u0431\u0443\u0434\u0438\u043D\u043E\u043A \u211612! \u0422\u0430\u043C \u043B\u044E\u0434\u0438 \u2014 \u0431\u0456\u0433\u043E\u043C!"
      _clip: {fileID: 8300000, guid: 3a0ccf6441ebdf347824b54d03e17f4b, type: 3}
      _hold: 3.5
    - _id: P03
      _text: "\u0422\u0443\u0442 \u0437\u0430\u043C\u043E\u043A. \u0412\u0456\u0437\u044C\u043C\u0438 \u0441\u043E\u043A\u0438\u0440\u0443 \u0443 \u0432\u0456\u0434\u0441\u0456\u043A\u0443 \u0437\u0456 \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F\u043C \u0456 \u0437\u0431\u0438\u0439 \u0439\u043E\u0433\u043E."
      _clip: {fileID: 8300000, guid: cece5b5dbbc0c8046a73c72a53b61758, type: 3}
      _hold: 3.5
    - _id: P04
      _text: "\u0426\u0435... \u0432\u0456\u043D \u0449\u043E, \u043A\u043E\u0442\u0456\u0432 \u0440\u044F\u0442\u0443\u0432\u0430\u0432?! \u0417\u0430\u0445\u043E\u0434\u044C! \u0412\u043E\u0433\u043E\u043D\u044C \u0431\u0456\u043B\u044F \u0441\u0445\u043E\u0434\u0456\u0432 \u2014 \u0432\u043E\u0433\u043D\u0435\u0433\u0430\u0441\u043D\u0438\u043A \u0443 \u0447\u0435\u0440\u0432\u043E\u043D\u043E\u043C\u0443 \u0449\u0438\u0442\u043A\u0443."
      _clip: {fileID: 8300000, guid: 4a692f12bb575d444a4d6442fad3c014, type: 3}
      _hold: 4.5
    - _id: P05
      _text: "\u0411\u0435\u0440\u0438 \u0439\u043E\u0433\u043E \u2014 \u0456 \u0434\u043E \u0432\u043E\u0433\u043D\u044E!"
      _clip: {fileID: 8300000, guid: 86f1d181a61879d4cb8bbfd7276fbebc, type: 3}
      _hold: 2.5
    - _id: P06
      _text: "\u041C\u0430\u0445\u043C\u0443\u0434, \u043B\u0456\u0444\u0442 \u043F\u0456\u0434 \u0447\u0430\u0441 \u043F\u043E\u0436\u0435\u0436\u0456? \u0422\u0438 \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E?"
      _clip: {fileID: 8300000, guid: b4f6ded763217e4468a3bb1c0c61e7b1, type: 3}
      _hold: 3
    - _id: P07
      _text: "\u041F\u0440\u043E\u0445\u0456\u0434 \u0447\u0438\u0441\u0442\u0438\u0439! \u041F\u0456\u0434\u0456\u0439\u043C\u0430\u0439\u0441\u044F, \u0442\u0430\u043C \u0449\u0435 \u043B\u044E\u0434\u0438!"
      _clip: {fileID: 8300000, guid: 27953282fde3cb243bb5c40433969c61, type: 3}
      _hold: 3.5
    - _id: P08
      _text: "\u0411\u0430\u0431\u0443\u0441\u044E \u043F\u0440\u0438\u0439\u043D\u044F\u0432, \u043D\u0430 \u0442\u0440\u0435\u0442\u044C\u043E\u043C\u0443 \u043F\u043E\u0432\u0435\u0440\u0441\u0456 \u0445\u0442\u043E\u0441\u044C \u043B\u0430\u0454\u0442\u044C\u0441\u044F, \u0431\u0456\u0433\u043E\u043C \u0442\u0443\u0434\u0438!"
      _clip: {fileID: 8300000, guid: 5c45d24b032e03b46ba702cfabce1c09, type: 3}
      _hold: 4
    - _id: P09
      _text: "\u0404 \u0434\u0440\u0443\u0433\u0438\u0439! \u0423\u0441\u0456 \u043D\u0430 \u0432\u0443\u043B\u0438\u0446\u0456 \u2014 \u041C\u0430\u0445\u043C\u0443\u0434\u0435, \u0432\u0438\u0445\u043E\u0434\u044C \u0437\u0432\u0456\u0434\u0442\u0438!"
      _clip: {fileID: 8300000, guid: 774a357d8e94c93429d40048825d9e7a, type: 3}
      _hold: 3
    - _id: P10
      _text: "\u0422\u0430 \u0442\u0438 \u0441\u0443\u043F\u0435\u0440\u0433\u0435\u0440\u043E\u0439!"
      _clip: {fileID: 8300000, guid: 46a368f2bd98019449538052c5b4e7f6, type: 3}
      _hold: 3
  - _character: 1
    _displayName: "\u041C\u0430\u0445\u043C\u0443\u0434"
    _color: {r: 1, g: 0.6, b: 0.3, a: 1}
    _lines:
    - _id: M01
      _text: "\u0411\u0430\u0431\u0443\u0441\u044E, \u043F\u043E\u0436\u0435\u0436\u043D\u0430! \u0412\u0438\u0445\u043E\u0434\u0438\u043C\u043E, \u0448\u0432\u0438\u0434\u043A\u043E!"
      _clip: {fileID: 8300000, guid: 756865fbbe8e7224189bf05820de71d1, type: 3}
      _hold: 3
    - _id: M02
      _text: "\u042F\u043A\u0456 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438, \u0431\u0430\u0431\u0443\u0441\u044E? \u0411\u0443\u0434\u0438\u043D\u043E\u043A \u0433\u043E\u0440\u0438\u0442\u044C!"
      _clip: {fileID: 8300000, guid: 5c3df2ce24946244399e9a7f967c5e78, type: 3}
      _hold: 3
    - _id: M03
      _text: "\u0414\u043E\u0431\u0440\u0435, \u0434\u0435 \u0432\u043E\u043D\u0438?"
      _clip: {fileID: 8300000, guid: 80e05e44823efe34086867a3c1394ff9, type: 3}
      _hold: 3
    - _id: M04
      _text: "\u0422\u0440\u0438\u043C\u0430\u0439\u0442\u0435\u0441\u044F \u043C\u0456\u0446\u043D\u0456\u0448\u0435. \u041F\u0456\u0434\u0435\u043C\u043E... \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C \u0448\u043B\u044F\u0445\u043E\u043C."
      _clip: {fileID: 8300000, guid: 68d8dfa496ba3f244920fc8f9e92a888, type: 3}
      _hold: 3
    - _id: M05
      _text: "\u0426\u0435 \u0433\u0430\u0437 \u0433\u043E\u0440\u0438\u0442\u044C! \u0414\u0435 \u0439\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u043A\u0440\u0438\u0442\u0438?"
      _clip: {fileID: 8300000, guid: 784d3cc7d7503e840ab3e2c49b3c9b64, type: 3}
      _hold: 3
    - _id: M06
      _text: "\u0417\u0430\u0440\u0430\u0437 \u044F \u0442\u0435\u0431\u0435 \u0432\u0440\u044F\u0442\u0443\u044E!"
      _clip: {fileID: 8300000, guid: 33b0325fbc2f55a48adb02ed96100f9a, type: 3}
      _hold: 3
    - _id: M07
      _text: "\u0417\u0430\u0440\u0430\u0437 \u0440\u0432\u043E\u043D\u0435! \u042F \u0443 \u0432\u0456\u043A\u043D\u043E!"
      _clip: {fileID: 8300000, guid: 4ea1197d3549cf74290e54fdebf2fbf7, type: 3}
      _hold: 2.5
  - _character: 2
    _displayName: "\u0411\u0430\u0431\u0443\u0441\u044F"
    _color: {r: 1, g: 0.85, b: 0.55, a: 1}
    _lines:
    - _id: G01
      _text: "\u0421\u0438\u043D\u043A\u0443! \u042F \u0442\u0443\u0442, \u0443 \u0441\u043F\u0430\u043B\u044C\u043D\u0456! \u0412\u043E\u0433\u043E\u043D\u044C \u043D\u0435 \u043F\u0443\u0441\u043A\u0430\u0454!"
      _clip: {fileID: 8300000, guid: 2173440b26950aa4fa1243cabf85b1cd, type: 3}
      _hold: 3
    - _id: G02
      _text: "\u0411\u0435\u0437 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0456\u0432 \u043D\u0435 \u043F\u0456\u0434\u0443!"
      _clip: {fileID: 8300000, guid: f1afef7892e77494dbceca74651e1b8a, type: 3}
      _hold: 3
    - _id: G03
      _text: "\u0410 \u044F \u0431\u0435\u0437 \u043D\u0438\u0445 \u043D\u0456\u043A\u0443\u0434\u0438!"
      _clip: {fileID: 8300000, guid: 2476dfeb67aaf1b49a1885125e5ec3d9, type: 3}
      _hold: 3
    - _id: G04
      _text: "\u0423 \u0441\u0435\u0439\u0444\u0456, \u0437\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u044E."
      _clip: {fileID: 8300000, guid: ccc0f242f3fe5b94fa21173cf897409d, type: 3}
      _hold: 3
    - _id: G05
      _text: "\u041E\u0439, \u0434\u044F\u043A\u0443\u044E, \u0441\u0438\u043D\u043A\u0443!"
      _clip: {fileID: 8300000, guid: 15650fd131e043643aede69f2ca699b3, type: 3}
      _hold: 3
    - _id: G06
      _text: "\u041D\u0443 \u043E\u0442. \u0422\u0435\u043F\u0435\u0440 \u043C\u043E\u0436\u043D\u0430 \u0439 \u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F."
      _clip: {fileID: 8300000, guid: 6021282d454b102409e6ee9680127088, type: 3}
      _hold: 3
    - _id: G07
      _text: "\u042F \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u2014 \u0431\u0435\u0437 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0456\u0432 \u043D\u0456\u043A\u0443\u0434\u0438!"
      _clip: {fileID: 0}
      _hold: 3
    - _id: G08
      _text: "\u0429\u043E \u0442\u0438 \u043D\u0430 \u043C\u0435\u043D\u0435 \u0434\u0438\u0432\u0438\u0448\u0441\u044F? \u041A\u0430\u0440\u0442\u0438\u043D\u0438 \u2014 \u043E\u043D!"
      _clip: {fileID: 0}
      _hold: 3
    - _id: G09
      _text: "\u0421\u0435\u0439\u0444 \u0431\u0430\u0447\u0438\u0448? \u041D\u0443 \u0442\u043E \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0439!"
      _clip: {fileID: 0}
      _hold: 3
    - _id: G10
      _text: "А-а-а-а-а!"
      _clip: {fileID: 8300000, guid: 7ac848c77dcc445ebce53e10e12573df, type: 3}
      _hold: 3
  - _character: 3
    _displayName: "\u0421\u0443\u0441\u0456\u0434"
    _color: {r: 0.75, g: 0.9, b: 1, a: 1}
    _lines:
    - _id: N01
      _text: "\u0420\u044F\u0442\u0443\u0439\u0442\u0435! \u0414\u043E\u043F\u043E\u043C\u043E\u0436\u0456\u0442\u044C, \u0445\u0442\u043E-\u043D\u0435\u0431\u0443\u0434\u044C!"
      _clip: {fileID: 8300000, guid: f34d6143d9c8d164ab1e73b2de18afdc, type: 3}
      _hold: 3.5
    - _id: N02
      _text: "\u0412\u0438\u0445\u0456\u0434 \u043F\u0435\u0440\u0435\u043A\u0440\u0438\u0442\u043E, \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0456\u0442\u044C!"
      _clip: {fileID: 8300000, guid: 7b805e9a19bcd84449f687f26fa74831, type: 3}
      _hold: 3
    - _id: N03
      _text: "\u0412\u0435\u043D\u0442\u0438\u043B\u0456 \u0432 \u043A\u043E\u043C\u043E\u0440\u0456."
      _clip: {fileID: 8300000, guid: d6f664111e7cdc04897c39f4f67d0ae0, type: 3}
      _hold: 3
    - _id: N04
      _text: "\u0413\u0430\u0437 \u043F\u0435\u0440\u0435\u043A\u0440\u0438\u0442\u043E! \u0413\u0430\u0441\u0438 \u0432\u043E\u0433\u043E\u043D\u044C!"
      _clip: {fileID: 8300000, guid: 6aba3350e1bb3bd41841e692c41e8ede, type: 3}
      _hold: 3
    - _id: N05
      _text: "\u0410 \u0446\u0435 \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u043E?"
      _clip: {fileID: 8300000, guid: 2f0b2e3e8d9ddcf49b936c10e33db553, type: 3}
      _hold: 4
    - _id: N06
      _text: "\u0410-\u0410-\u0410-\u0410-\u0410!"
      _clip: {fileID: 8300000, guid: 32c8a06cefd44ddba33346a5c353b5c1, type: 3}
      _hold: 3
  - _character: 4
    _displayName: "\u0414\u044F\u0434\u044C\u043A\u043E"
    _color: {r: 1, g: 0.55, b: 0.25, a: 1}
    _lines:
    - _id: U01
      _text: "\u0414\u043E\u0440\u043E\u0433\u0443! \u042F \u0442\u0443\u0442 \u0443\u0441\u0456\u0445 \u0440\u044F\u0442\u0443\u044E!"
      _clip: {fileID: 8300000, guid: 3f176a97ebc41d842bb354f6345abc0b, type: 3}
      _hold: 3
    - _id: U02
      _text: "\u0412\u0456\u0434\u0456\u0439\u0434\u0456\u0442\u044C. \u041F\u0440\u043E\u0444\u0435\u0441\u0456\u043E\u043D\u0430\u043B \u043F\u0440\u0430\u0446\u044E\u0454."
      _clip: {fileID: 8300000, guid: 0138a8ceb483ba94294ee75bfa3472b6, type: 3}
      _hold: 3
    - _id: U03
      _text: "\u042F \u0432\u0441\u0456\u0445 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0432! \u0424\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0443\u0439\u0442\u0435!"
      _clip: {fileID: 8300000, guid: 2df69b31508a2bd44ae1305018086bb5, type: 3}
      _hold: 3
